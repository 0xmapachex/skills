{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xmapachex/skills/pr-overview/schema",
  "title": "PR Overview Spec",
  "type": "object",
  "required": ["meta", "summary", "architecture", "open_questions"],
  "additionalProperties": false,
  "$defs": {
    "image": {
      "type": "object",
      "required": ["alt"],
      "properties": {
        "src":      { "type": "string", "minLength": 1, "description": "Local path (relative to the spec file or absolute) or an http(s) URL. Local paths get inlined as base64 by the renderer." },
        "alt":      { "type": "string", "minLength": 1, "description": "Required for accessibility — describe the image content in one sentence." },
        "caption":  { "type": "string", "description": "Optional one-line caption shown beneath the image." },
        "route":    { "type": "string", "description": "Path under the capture base URL — used by scripts/capture.mjs to fetch + screenshot. Ignored at render time." },
        "viewport": {
          "type": "object",
          "description": "Capture-only — viewport dimensions for the headless browser.",
          "properties": {
            "width":  { "type": "integer", "minimum": 320 },
            "height": { "type": "integer", "minimum": 240 }
          }
        },
        "wait_for": { "type": "string", "description": "Capture-only — CSS selector or `networkidle` to wait for before screenshotting." },
        "full_page": { "type": "boolean", "description": "Capture-only — screenshot the entire scrollable page (default false; only the viewport is captured)." }
      }
    },
    "imageList": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/image" }
    },
    "routeParameter": {
      "type": "object",
      "required": ["name", "in", "description"],
      "additionalProperties": false,
      "properties": {
        "name":        { "type": "string", "minLength": 1 },
        "in":          { "enum": ["path", "query", "body", "header"] },
        "required":    { "type": "boolean" },
        "type":        { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "routeBody": {
      "type": "object",
      "required": ["description"],
      "additionalProperties": false,
      "properties": {
        "required":     { "type": "boolean" },
        "type":         { "type": "string" },
        "description":  { "type": "string" },
        "content_type": { "type": "string" },
        "example":      {}
      }
    },
    "routeResponse": {
      "type": "object",
      "required": ["code", "description"],
      "additionalProperties": false,
      "properties": {
        "code":         { "type": "string", "minLength": 1 },
        "description":  { "type": "string" },
        "content_type": { "type": "string" },
        "example":      {}
      }
    },
    "routeItem": {
      "type": "object",
      "required": ["method", "path", "status", "summary"],
      "additionalProperties": false,
      "properties": {
        "method":        { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
        "path":          { "type": "string", "minLength": 1 },
        "status":        { "enum": ["added", "changed", "removed"] },
        "summary":       { "type": "string", "minLength": 1 },
        "details":       { "type": "string" },
        "auth":          { "type": "string" },
        "data":          { "type": "string" },
        "replacement":   { "type": "string" },
        "review_focus":  { "type": "string" },
        "files":         { "type": "array", "items": { "type": "string" } },
        "tests":         { "type": "array", "items": { "type": "string" } },
        "parameters":    { "type": "array", "items": { "$ref": "#/$defs/routeParameter" } },
        "request_body":  { "$ref": "#/$defs/routeBody" },
        "responses":     { "type": "array", "items": { "$ref": "#/$defs/routeResponse" } }
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "base", "head", "files_changed", "additions", "deletions"],
      "properties": {
        "title":         { "type": "string", "minLength": 1 },
        "base":          { "type": "string", "minLength": 1 },
        "head":          { "type": "string", "minLength": 1 },
        "files_changed": { "type": "integer", "minimum": 0 },
        "additions":     { "type": "integer", "minimum": 0 },
        "deletions":     { "type": "integer", "minimum": 0 },
        "pr_type_tags":  { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "required": ["tldr", "ships"],
      "properties": {
        "tldr":    { "type": "string", "maxLength": 360 },
        "ships":   { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string" } },
        "why":     { "type": "string", "maxLength": 260 },
        "changes": { "type": "array", "maxItems": 6, "items": { "type": "string" } },
        "topics": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["title", "summary"],
            "properties": {
              "title":      { "type": "string" },
              "summary":    { "type": "string" },
              "body":       { "type": "string" },
              "highlights": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
              "code": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["body"],
                  "properties": {
                    "lang": { "type": "string" },
                    "file": { "type": "string" },
                    "body": { "type": "string" }
                  }
                }
              },
              "images": { "$ref": "#/$defs/imageList" }
            }
          }
        }
      }
    },
    "screenshots": {
      "type": "object",
      "required": ["items"],
      "description": "Top-level visual gallery — most useful for UI-heavy PRs where the diff is hard to picture from prose alone. Rendered near the top of the document below the executive briefing.",
      "properties": {
        "summary":    { "type": "string", "description": "One-sentence lede, plain English." },
        "highlights": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "items":      { "$ref": "#/$defs/imageList" }
      }
    },
    "architecture": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "summary":    { "type": "string" },
        "highlights": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "kind"],
            "properties": {
              "id":      { "type": "string" },
              "label":   { "type": "string" },
              "kind":    { "enum": ["service", "module", "datastore", "external", "ui", "job"] },
              "changed": { "type": "boolean" }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from":  { "type": "string" },
              "to":    { "type": "string" },
              "label": { "type": "string" },
              "kind":  { "enum": ["sync", "async", "data"] }
            }
          }
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "summary":          { "type": "string" },
              "files":            { "type": "array", "items": { "type": "string" } },
              "responsibilities": { "type": "array", "items": { "type": "string" } },
              "status":           { "enum": ["added", "changed", "removed", "context"] },
              "images":           { "$ref": "#/$defs/imageList" }
            }
          }
        }
      }
    },
    "flow": {
      "type": "object",
      "required": ["actors", "steps"],
      "properties": {
        "title":      { "type": "string" },
        "summary":    { "type": "string" },
        "highlights": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "images":     { "$ref": "#/$defs/imageList" },
        "actors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id":    { "type": "string" },
              "label": { "type": "string" },
              "kind":  { "enum": ["user", "service", "module", "datastore", "external"] }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "label"],
            "properties": {
              "from":        { "type": "string" },
              "to":          { "type": "string" },
              "label":       { "type": "string" },
              "changed":     { "type": "boolean" },
              "details_id":  { "type": "string" }
            }
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/properties/flow" }
    },
    "database": {
      "type": "object",
      "required": ["tables"],
      "properties": {
        "summary":    { "type": "string" },
        "highlights": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "status", "fields"],
            "properties": {
              "id":     { "type": "string" },
              "name":   { "type": "string" },
              "status": { "enum": ["added", "changed", "removed", "context"] },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "type", "status"],
                  "properties": {
                    "name":     { "type": "string" },
                    "type":     { "type": "string" },
                    "status":   { "enum": ["added", "changed", "removed", "context"] },
                    "nullable": { "type": "boolean" },
                    "default":  { "type": "string" },
                    "privacy":  { "type": "boolean" }
                  }
                }
              },
              "indexes": { "type": "array", "items": { "type": "object" } },
              "details": { "type": "object" }
            }
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from":   { "type": "string" },
              "to":     { "type": "string" },
              "status": { "enum": ["added", "changed", "removed", "context"] }
            }
          }
        }
      }
    },
    "routes": {
      "type": "object",
      "required": ["groups"],
      "description": "Compact route-delta section. Include only when the PR adds, removes, or materially changes route handlers.",
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "scope_note": { "type": "string" },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "added":   { "type": "integer" },
            "removed": { "type": "integer" },
            "changed": { "type": "integer" },
            "net":     { "type": "integer" }
          }
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["title", "routes"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "routes": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/routeItem" }
              }
            }
          }
        }
      }
    },
    "risk_rollout": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "severity", "notes"],
            "properties": {
              "title":    { "type": "string" },
              "severity": { "enum": ["info", "watch", "careful"] },
              "notes":    { "type": "string" },
              "files":    { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "open_questions": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
